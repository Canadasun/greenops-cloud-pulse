# secrets and generated certificates – never committed
broker/certs/*
!broker/certs/.gitkeep
.env
local.settings.json
# build / runtime
__pycache__/
*.pyc
.venv/
node_modules/
dist/
dist-azure/
.pytest_cache/
coverage/
playwright-report/
test-results/
.azurite/
*.log

# Terraform working files and state (state can hold secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

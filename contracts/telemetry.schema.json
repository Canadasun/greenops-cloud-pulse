{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenops.local/contracts/telemetry.schema.json",
  "title": "TelemetryMessage",
  "description": "One reading from one truck, published every 10 seconds (Part 1, Appendix A). Owner: Ying Song (Role 1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "truck_id",
    "route_id",
    "timestamp",
    "lat",
    "lon",
    "speed_kmh",
    "temp_c",
    "humidity_pct",
    "door_open",
    "cargo_type",
    "temp_min_c",
    "temp_max_c",
    "scheduled_eta"
  ],
  "properties": {
    "truck_id": {
      "type": "string",
      "pattern": "^TRK-[0-9]{3}$"
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "speed_kmh": {
      "type": "number",
      "minimum": 0,
      "maximum": 200
    },
    "temp_c": {
      "type": "number",
      "minimum": -40,
      "maximum": 60
    },
    "humidity_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "door_open": {
      "type": "boolean"
    },
    "cargo_type": {
      "type": "string",
      "enum": [
        "vaccines",
        "fresh_produce",
        "frozen_food"
      ]
    },
    "temp_min_c": {
      "type": "number"
    },
    "temp_max_c": {
      "type": "number"
    },
    "scheduled_eta": {
      "type": "string",
      "format": "date-time"
    },
    "simulation_time_scale": {
      "type": "number",
      "minimum": 1,
      "description": "Demo time acceleration: GPS speed equals reported physical speed multiplied by this factor."
    },
    "parked": {
      "type": "boolean",
      "description": "Only on the last reading of a planned run: the truck is parked, so the silence that follows is not a breakdown."
    }
  }
}
